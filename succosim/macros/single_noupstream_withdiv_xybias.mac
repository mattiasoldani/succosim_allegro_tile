# initialise the simulation
/run/initialize

# select run type - [beam config (e.g. bb_0.5p)]_[particle (e.g. pi)]
/control/alias beam mu_5p_mu

# beam features
/control/execute /eos/experiment/newtile/beamtests/26_05_t10/sim_utils/beams/g4_macros/{beam}_noupstream_withdiv_xybias.mac

# shoot!
/run/beamOn 10000