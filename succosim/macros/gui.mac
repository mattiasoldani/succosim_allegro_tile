# SET - issue custom commands here
# vvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvv
/custom/NLayers 13
/custom/NPeriods 13
/custom/NStackedMods 1
/custom/CoarseRO 3
/custom/BShowInner true
/custom/BShowSupport true
/custom/BShowCatcherFrontBack false
/custom/BShowCatcherSide false
/custom/BShowCatcherPhi false
/custom/StackRotationY 0
/custom/StackTranslationX 0
/custom/StackTranslationY 0
/custom/StackTranslationZ 0
# ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^

# initialise the simulation
/run/initialize

# basic graphical settings
/vis/open OGLSQt
/vis/drawVolume
/vis/scene/add/trajectories smooth
/vis/scene/endOfEventAction accumulate

# SET - optional graphical commands (can be commented)
# --> cartesian reference (at the centre of the world)
#/vis/scene/add/axes 0 0 0
# --> default direction of view
/vis/viewer/set/viewpointVector 1 1 -1

# don't shoot anything --> waiting for manual input from the GUI